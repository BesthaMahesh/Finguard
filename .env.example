# Environment Configuration for FinGuard Platform
PROJECT_NAME="FinGuard - Autonomous Financial Risk Intelligence"
ENVIRONMENT="development"
DEBUG=true

# API & Server Configuration
API_V1_STR="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (SQLite default for local dev, PostgreSQL compatible)
DATABASE_URL="sqlite:///./finguard.db"

# LLM Provider Configuration
LLM_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Security & RBAC Configuration
SECRET_KEY="finguard-secret-key-for-development-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
STRICT_AUTH=false

# Enterprise Initial Account Provisioning (Override default dev credentials)
DEFAULT_USER_EMAIL="user@finguard.local"
DEFAULT_USER_PASSWORD="<configure-secure-password>"
DEFAULT_ADMIN_EMAIL="admin@finguard.local"
DEFAULT_ADMIN_PASSWORD="<configure-secure-admin-password>"

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=100

# OpenTelemetry & Observability
OTEL_SERVICE_NAME="finguard-risk-intelligence"
OTEL_EXPORTER_OTLP_ENDPOINT=""
ENABLE_TRACING=true

# Data & Model Configuration
DATASET_RAW_PATH="PS_20174392719_1491204439457_log.csv"
MODEL_ARTIFACTS_DIR="./models"
CHROMA_PERSIST_DIR="./chroma_db"
RANDOM_SEED=42
FRAUD_THRESHOLD=0.65
